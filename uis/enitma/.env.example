# enITma platform — variables de entorno (sin secretos reales).
# Copia a .env.local para desarrollo:  cp .env.example .env.local

# --- Proveedor de IA del asistente enITma Space AI ---
# El MVP funciona con un motor LOCAL determinista si esto queda vacío ("mock").
# Valores posibles: mock | bedrock | openai
AI_PROVIDER=mock

# --- Bedrock (opcional, 🔵 PLANNED) — solo en el servidor, nunca en el repo ---
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- OpenAI (opcional, 🔵 PLANNED) ---
