# Configuración de desarrollo para docker compose (raíz).
# Copia este archivo a .env para desarrollo local: cp .env.example .env
# NO contiene secretos: solo URLs y puertos de desarrollo.

# --- Puertos publicados al host ---
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
ENITMA_PORT=3002
BACKEND_PORT=8000

# --- enITma AI (OpenAI) — para Docker Compose ---
# AI_PROVIDER=openai activa OpenAI; si falta la clave, cae al motor local "mock".
# NO pongas la clave real en .env.example (se versiona). Ponla solo en .env (ignorado).
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- URLs que usa el NAVEGADOR (host) para llegar al backend ---
# El navegador corre en el host: debe usar localhost, no el hostname Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000

# --- URLs de las apps del proyecto (navegación cruzada entre ellas) ---
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001
NEXT_PUBLIC_TALENT_URL=http://localhost:3002
