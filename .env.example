# Configuración de desarrollo para docker compose (raíz).
# Copia este archivo a .env para desarrollo local: cp .env.example .env
# NO contiene secretos: solo URLs y puertos de desarrollo.

# --- Puertos publicados al host ---
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
BACKEND_PORT=8000

# --- URLs que usa el NAVEGADOR (host) para llegar al backend ---
# El navegador corre en el host: debe usar localhost, no el hostname Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000
