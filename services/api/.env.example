# TrackFlow API — variables de entorno del SERVIDOR (sin secretos reales).
# Copia a un archivo local NO versionado para desarrollo/despliegue.
#
# IMPORTANTE (AGENTS.md): las credenciales AWS NUNCA van en el repo ni en el
# frontend. Solo se leen aquí, en el servidor. En producción usa un gestor de
# secretos (p. ej. AWS Secrets Manager) o el rol de la instancia/tarea.

# --- Módulo Facturas (Fase 1) — almacenamiento en S3 ---
# Si no defines un bucket, el endpoint /invoices/presign responde en modo
# "simulado" (no contacta AWS) para permitir la demo local del flujo completo.
# INVOICES_S3_BUCKET=nombre-de-tu-bucket
# AWS_REGION=us-east-1

# Prefijo (carpeta lógica) dentro del bucket para las facturas entrantes.
# INVOICES_S3_PREFIX=facturas/entrantes

# Tope de tamaño del PDF en bytes (por defecto 25 MB) y validez de la URL (s).
# INVOICES_MAX_SIZE_BYTES=26214400
# INVOICES_PRESIGN_EXPIRES=900

# Credenciales AWS (SOLO servidor; preferible usar rol IAM en producción).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
